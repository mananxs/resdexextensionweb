# ───────────────────────── Database (Neon Postgres) ─────────────────────────
# Pooled connection (host contains "-pooler") — used by the app at runtime
DATABASE_URL="postgresql://neondb_owner:npg_GX1mHr2xStgf@ep-cold-shape-bejsxizo-pooler.c-9.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# Direct connection (same string WITHOUT "-pooler") — used by `prisma db push` / `prisma migrate`
DIRECT_URL="postgresql://neondb_owner:npg_GX1mHr2xStgf@ep-cold-shape-bejsxizo.c-9.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ───────────────────────── Auth / security (REQUIRED) ─────────────────────────
# Long random strings:  openssl rand -base64 32
SESSION_SECRET="99cc893ff92e8d758b1e2ac55741bb69f9c13a5354536fca0c8abb24b375aa77"
# Encrypts each HR's personal Groq/Gemini keys at rest (AES-256-GCM). If unset, SESSION_SECRET is used.
# Rotating it makes previously saved personal keys unreadable (HRs just re-enter them).
APP_ENCRYPTION_KEY="0f7e751eaeaf19a343e19579175e8b822278d122f9c75155ac9ea1b80fb0b299"

# Who can create an HR account:
#   SIGNUP_INVITE_CODE set  → sign-up requires this code (recommended: share it only with your HRs)
#   ALLOW_SIGNUP=true       → anyone can sign up
#   neither                 → closed, except the very FIRST account on a fresh database (bootstrap admin)
SIGNUP_INVITE_CODE="xsnaukri-invite-99"
ALLOW_SIGNUP="false"
# Upgrading from the single-tenant build? That user has no password yet: sign up once with THIS email to claim it
# (keeps its jobs/candidates). Leave empty when starting fresh.
LEGACY_CLAIM_EMAIL=""

# ───────────────────────── Shared LLM key pool ─────────────────────────
# Any mix of these works; all are merged and de-duplicated. Add keys to add capacity — requests rotate across them,
# cool down a key on 429/quota, park it when x-ratelimit-remaining-* gets low, and fail over Groq → Gemini.
# Groq keys: https://console.groq.com/keys     Gemini keys: https://aistudio.google.com/apikey
GROQ_API_KEYS="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,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"
# GROQ_API_KEY="gsk_single_key"        # legacy single key still works
# GROQ_API_KEY_1="gsk_..."             # …up to GROQ_API_KEY_50
GEMINI_API_KEYS="AQ.Ab8RN6L6OckLOGXGDWk1oEnsa0gtyu38SEKFKCGj50ykN0YN9Q,AQ.Ab8RN6LmTSwd94V05bwDy_4_5UgpJ1zxIX0f8NLOj_TPH_oFkw"
# GEMINI_API_KEY="AIza..."
# GEMINI_API_KEY_1="AIza..."           # …up to GEMINI_API_KEY_50

# ───────────────────────── LLM tuning (all optional) ─────────────────────────
# Provider preference; the next provider is used when every key of the first is cooling / failing.
LLM_PROVIDER_ORDER="groq,gemini"
# Models (defaults shown)
# GROQ_MODEL_RUBRIC="openai/gpt-oss-120b"
# GROQ_MODEL_BATCH="openai/gpt-oss-20b"
# GROQ_MODEL_DEEP="openai/gpt-oss-120b"
# GEMINI_MODEL_RUBRIC="gemini-2.5-flash"
# GEMINI_MODEL_BATCH="gemini-2.5-flash"
# GEMINI_MODEL_DEEP="gemini-2.5-flash"      # gemini-2.5-pro for maximum accuracy on paid quota
# Parallel LLM calls per request (default: ~2 per key, 2–6)
# LLM_CONCURRENCY="4"
# Cards per LLM call (default 10). Smaller = fewer JSON failures.
# LLM_BATCH_CHUNK="10"
# Park a key when Groq reports fewer than this many requests / tokens left in the window (defaults 2 / 3000)
# LLM_MIN_REMAINING_REQUESTS="2"
# LLM_MIN_REMAINING_TOKENS="3000"
# If all keys are cooling but one frees up within this many ms, wait instead of failing (default 6000)
# LLM_MAX_WAIT_MS="6000"
# Per-call wall-clock budget incl. failovers; keep below the route's maxDuration of 60 s (default 52000)
# LLM_CALL_BUDGET_MS="52000"
# Max characters of a résumé sent to the model after smart trimming (default 12000)
# RESUME_LLM_MAX_CHARS="12000"
# Log every router decision (no secrets) — debugging only
# LLM_DEBUG="1"
