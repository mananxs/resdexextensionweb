# Groq API key — https://console.groq.com/keys
GROQ_API_KEY="gsk_your_key_here"

# Neon Postgres (https://console.neon.tech → your project → Connect)
# Pooled connection (host contains "-pooler") — used by the app at runtime
DATABASE_URL=""
# Direct connection (same string WITHOUT "-pooler") — used by `prisma migrate`
DIRECT_URL=""

# Single-tenant "current recruiter" used by the dashboard (no login screen in this build).
# Swap getCurrentUser() in src/lib/user.ts for real auth (NextAuth/Clerk) for multi-user deployments.
DEFAULT_USER_EMAIL="recruiter@example.com"
DEFAULT_USER_NAME="Recruiter"
